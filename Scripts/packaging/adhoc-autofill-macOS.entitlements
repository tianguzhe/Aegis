<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ad-hoc distribution subset of Config/AegisAutoFill-macOS.entitlements. The credential provider
     entitlement needs a provisioning profile, so the bundled extension is sandboxed but inactive. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
